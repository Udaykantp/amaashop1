# ─────────────────────────────────────────────────────────────────────────────
# AmaaShop platform — environment
# Copy to .env.local and fill in. In production these come from GCP Secret Manager.
# Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase — client SDK (public, safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Google Analytics (GA4) measurement id. Leave blank to disable analytics.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase — Admin SDK (server only). Paste the service-account JSON as a single
# line, or point GOOGLE_APPLICATION_CREDENTIALS at the file on disk. Not needed
# for local dev if you're running against the Auth + Firestore emulators below.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Local dev only — point the app at the Firebase emulator suite instead of the
# real project (`npm run emulators`, then set both of these in .env.local).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── Super Admin access control ──────────────────────────────────────────────
# HARD allow-list: ONLY these e-mails may hold the SUPER_ADMIN role or reach the
# Super Admin panel. A `role = SUPER_ADMIN` row whose e-mail is not listed here
# is inert (fail-closed). Comma / space separated, case-insensitive.
SUPER_ADMIN_ALLOWLIST=ashokkumarmoharana05@gmail.com
# One-time bootstrap: first sign-in with this e-mail is promoted to SUPER_ADMIN,
# but only while no Super Admin exists yet AND it is on SUPER_ADMIN_ALLOWLIST.
BOOTSTRAP_SUPER_ADMIN_EMAIL=ashokkumarmoharana05@gmail.com

# Session cookie
SESSION_COOKIE_NAME=amaashop_session
SESSION_COOKIE_MAX_AGE_DAYS=5

# Field-level encryption for Aadhaar / PAN / bank (AES-256-GCM).
# 32-byte key, base64. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# HMAC key for blind-index hashing (duplicate-identity detection). 32-byte base64.
BLIND_INDEX_KEY=

# Google Cloud Storage — private KYC bucket
GCS_BUCKET_KYC=
GCS_PROJECT_ID=
# Public product-image bucket. Admin catalog uploads go here and are served
# from https://storage.googleapis.com/<bucket>/<path>. Create with:
#   gcloud storage buckets create gs://<name> --location=ASIA-SOUTH1 --no-uniform-bucket-level-access
GCS_BUCKET_MEDIA=

# Commission worker callback (Cloud Run) — shared secret for the queue drain endpoint
WORKER_SHARED_SECRET=

# Payments — SIMULATED this phase. Razorpay/Cashfree keys go here later.
PAYMENT_PROVIDER=SIMULATED

# ── Public /join registration funnel ────────────────────────────────────────
# Cloudflare Turnstile guards the referral-registration form (there is NO OTP —
# this CAPTCHA + a phone-uniqueness check is the only bot shield). Leave BOTH
# blank in dev/CI to disable the check. Get keys at
#   https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Live Price Comparison (PDP) ──────────────────────────────────────────────
# Third-party scraping API that resolves a SKU to Amazon/Flipkart/JioMart
# prices. Leave BOTH blank to use the built-in deterministic mock (dev/CI).
SCRAPER_API_URL=
SCRAPER_API_KEY=
SCRAPER_API_TIMEOUT_MS=15000
# How long a cached competitor price is trusted before a re-scrape (hours).
COMPETITOR_PRICE_TTL_HOURS=24
# Bearer token required to call POST-style forced refresh:
#   GET /api/compare-price?sku=...&refresh=1   (cron job / admin only)
PRICE_COMPARE_REVALIDATE_SECRET=
