rules_version = '2';

// All reads/writes go through server actions and API routes using the
// firebase-admin SDK (service-account credentials, bypasses these rules
// entirely) — the same trust model the app used with Prisma/Cloud SQL, where
// only the server ever held a database credential. No client (web, mobile)
// talks to Firestore directly, so every collection is closed to client SDKs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
