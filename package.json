{
  "name": "amaashop",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:emulators": "firebase emulators:start --only auth,firestore --project amaashop-80cfd",
    "dev:all": "concurrently -k -n auth,web -c yellow,green \"npm:dev:emulators\" \"npm:dev\"",
    "emulators": "firebase emulators:start --only auth,firestore --project amaashop-80cfd",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-base.ts",
    "office:seed": "dotenv -e .env.local -- tsx scripts/seed-distributor.ts",
    "admin:create": "dotenv -e .env.local -- tsx scripts/create-super-admin.ts",
    "admin:set-phone": "dotenv -e .env.local -- tsx scripts/set-admin-phone.ts",
    "catalog:seed": "dotenv -e .env.local -- tsx scripts/seed-catalog.ts",
    "db:seed:prod": "tsx scripts/seed-base.ts && tsx scripts/seed-catalog.ts",
    "functions:deploy": "firebase deploy --only functions --project amaashop-80cfd",
    "verify": "dotenv -e .env.local -- node scripts/verify-auth.mjs && dotenv -e .env.local -- node scripts/verify-genealogy.mjs && dotenv -e .env.local -- node scripts/verify-move.mjs",
    "network:migrate-binary": "dotenv -e .env.local -- tsx scripts/migrate-to-binary.ts",
    "network:migrate-binary:apply": "dotenv -e .env.local -- tsx scripts/migrate-to-binary.ts --apply",
    "migrate:to-firestore": "prisma generate && dotenv -e .env.local -- tsx scripts/migrate-to-firestore.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.0.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.28.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@prisma/client": "^6.2.1",
    "@supabase/supabase-js": "^2.49.4",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "firebase-tools": "^15.24.0",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
